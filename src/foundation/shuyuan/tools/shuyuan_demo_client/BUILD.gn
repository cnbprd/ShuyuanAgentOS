import("//build/ohos.gni")

# 跨 SA 串通演示客户端（测试可执行）。
# 已通过本目录 bundle.json 的 sub_component 登记为独立产品组件。
ohos_executable("shuyuan_demo_client") {
    sources = [
        "demo_client.cpp",
    ]

    include_dirs = [
        "//foundation/shuyuan/lingtai/interfaces/innerkits/include",
        "//foundation/shuyuan/jingzhi/interfaces/innerkits/include",
        "//foundation/shuyuan/jianguan/interfaces/innerkits/include",
        "//foundation/shuyuan/heming/interfaces/innerkits/include",
        "//foundation/shuyuan/lingzhong/interfaces/innerkits/include",
        "//foundation/shuyuan/interfaces/innerkits/include",
        "//foundation/systemabilitymgr/samgr/interfaces/innerkits/samgr_proxy/include",
        "//commonlibrary/c_utils/base/include",
    ]

    deps = [
        "//foundation/shuyuan/lingtai:lingtai_interfaces",
        "//foundation/shuyuan/jingzhi:jingzhi_interfaces",
        "//foundation/shuyuan/jianguan:jianguan_interfaces",
        "//foundation/shuyuan/heming:heming_interfaces",
        "//foundation/shuyuan/lingzhong:lingzhong_interfaces",
        "//foundation/systemabilitymgr/safwk/interfaces/innerkits/safwk:system_ability_fwk",
        "//foundation/systemabilitymgr/samgr/interfaces/innerkits/samgr_proxy:samgr_proxy",
        "//foundation/communication/ipc/interfaces/innerkits/ipc_core:ipc_core",
        "//commonlibrary/c_utils/base:utils",
    ]

    part_name = "shuyuan_demo_client"
    install_enable = true
}
