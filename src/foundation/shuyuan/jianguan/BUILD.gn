import("//build/ohos.gni")

# 监观（感知层） SA 动态库：由 init 经 sa_main 加载，向 samgr 注册为 SA 9902。
# 服务库只包含服务实现与 Stub；Proxy 已拆到 <层>_interfaces，避免客户端为了
# iface_cast 而链接整个服务库，把 SA 注册静态对象带进客户端进程。
ohos_shared_library("jianguan_service") {
    sources = [
        "services/src/jianguan_service.cpp",
        "services/src/jianguan_service_stub.cpp",
    ]

    include_dirs = [
        "interfaces/innerkits/include",
        "services/include",
        "//foundation/shuyuan/interfaces/innerkits/include",
        "//commonlibrary/c_utils/base/include",
    ]

    deps = [
        "//foundation/systemabilitymgr/safwk/interfaces/innerkits/safwk:system_ability_fwk",
        "//foundation/communication/ipc/interfaces/innerkits/ipc_core:ipc_core",
        "//base/hiviewdfx/hilog/interfaces/native/innerkits:libhilog",
        "//commonlibrary/c_utils/base:utils",
    ]

    part_name = "jianguan"
    install_enable = true
    relative_install_dir = "lib64"
}

# 对外接口库：公开接口头 + Proxy 实现，供客户端 iface_cast 使用。
# 头文件通过 public_configs 传播；inner_kits 的 header 元数据在 bundle.json 中声明。
config("jianguan_interfaces_public_config") {
    include_dirs = [
        "interfaces/innerkits/include",
        "//foundation/shuyuan/interfaces/innerkits/include",
        "//commonlibrary/c_utils/base/include",
    ]
}

ohos_shared_library("jianguan_interfaces") {
    sources = [
        "interfaces/innerkits/src/jianguan_service_proxy.cpp",
    ]

    include_dirs = [
        "interfaces/innerkits/include",
        "//foundation/shuyuan/interfaces/innerkits/include",
        "//commonlibrary/c_utils/base/include",
    ]

    public_configs = [ ":jianguan_interfaces_public_config" ]

    deps = [
        "//foundation/communication/ipc/interfaces/innerkits/ipc_core:ipc_core",
        "//commonlibrary/c_utils/base:utils",
    ]

    part_name = "jianguan"
    install_enable = true
    relative_install_dir = "lib64"
}
